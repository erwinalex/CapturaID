<?xml version="1.0" encoding="utf-8"?>
<!--
    SOLO PARA COMPILACIONES DE DEPURACIÓN.

    Este archivo reemplaza al de src/main durante `assembleDebug`, y su única
    diferencia es que permite tráfico sin cifrar. Existe para poder probar
    contra un servidor que todavía no tiene certificado, sin tener que aflojar
    la configuración del APK que se instala en los kioskos.

    El de src/main —el que se compila en release— sigue con
    cleartextTrafficPermitted="false" y confiando únicamente en la CA propia.
    Si alguien configura una dirección http en un APK de release, la app lo
    rechaza al capturarla (ver DireccionServidor) y la red lo bloquearía de
    todos modos.

    Mientras uses este build, ten presente que el token del kiosko viaja en
    claro por la red.
-->
<network-security-config>

    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <!-- La CA propia también, para poder probar https en depuración. -->
            <certificates src="@raw/schid_ca" />
        </trust-anchors>
    </base-config>

</network-security-config>
