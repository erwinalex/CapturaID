<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!--
      NO poner InvariantGlobalization en true: Microsoft.Data.SqlClient no
      soporta ese modo y falla al abrir la conexión con
      "Globalization Invariant Mode is not supported", antes siquiera de
      intentar llegar al servidor.
    -->
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.2.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SchId.Shared\SchId.Shared.csproj" />
  </ItemGroup>

</Project>
